# tts-merkez — yapılandırma örneği
#
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# `.env` .gitignore'dadır; gerçek parolalar depoya girmez.
#
# Kodda sabit yoktur: örnekleme hızı, birleştirme parametreleri ve bütçe
# sınırları dahil her sayı buradan okunur.

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Küme: C:\Users\ibrah\pgdata  (PostgreSQL 18.4)
# Başlat:  & "C:\Program Files\PostgreSQL\18\bin\pg_ctl.exe" -D C:\Users\ibrah\pgdata -l C:\Users\ibrah\pgdata\server.log start
# Durdur:  & "C:\Program Files\PostgreSQL\18\bin\pg_ctl.exe" -D C:\Users\ibrah\pgdata stop
#
# Veritabanı `LOCALE_PROVIDER icu ICU_LOCALE 'tr-TR'` ile oluşturulmalıdır;
# aksi halde lower('İ') beklenen sonucu vermez ve kelime anahtarları bozulur.
DATABASE_URL=postgresql://KULLANICI:PAROLA@127.0.0.1:5432/ttsmerkez
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=DEGISTIR
PGDATABASE=ttsmerkez

# ── Google Cloud TTS ──────────────────────────────────────────────────────
# v1beta1 gerekli (SSML mark zaman damgaları için). İki kimlik yolundan biri:
GOOGLE_TTS_API_KEY=DEGISTIR
# GOOGLE_APPLICATION_CREDENTIALS=C:\yol\servis-hesabi.json
#
# İkisi de yoksa sistem SAHTE motora düşer: panel açılır, Google'a hiç
# gidilmez, üretilen ses gerçek değildir (sinüs).

# ── Banka depolama ────────────────────────────────────────────────────────
BANKA_DIZINI=./veri/banka
# Ölçüldü (§6.6): tr-TR'deki bütün tiyerler 24000 Hz üretiyor.
BANKA_ORNEKLEME_HIZI=24000

# ── Sunucu ────────────────────────────────────────────────────────────────
PORT=3000
SUNUCU_ADRESI=127.0.0.1
# En az 32 karakter. Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTURUM_GIZLI_ANAHTARI=DEGISTIR_EN_AZ_32_KARAKTER_OLMALI
# gelistirme | uretim | test  — `uretim` çerezleri secure yapar (HTTPS şart)
ORTAM=gelistirme

# ── Google bütçe koruması ─────────────────────────────────────────────────
# Geliştirme turu boyunca Google'a giden toplam KLİP sayısı tavanı.
# Sayaç veri/google-butce.json dosyasında tutulur ve süreç yeniden başlayınca
# SIFIRLANMAZ. Aylık kotadan (§6.4) ayrı, ondan önce çalışan ikinci duvardır.
GOOGLE_KLIP_BUTCESI=50
# Eşzamanlılık 5–10 arası; 429 yağmurunu önler (§7.5 kural 9).
GOOGLE_ESZAMANLILIK=5
GOOGLE_ISTEK_HIZI_SN=5

# ── Üretim hattı ──────────────────────────────────────────────────────────
# Parti boyutu 200–1000 makul (§A.2): N klip, tek transaction, tek sürüm artışı.
URETIM_PARTI_BOYUTU=200
# Sahiplenme yaşı: Google çağrısı normalde ~300 ms; 60 sn hem çökme
# kurtarmasına yeter hem canlı üretimi yanlışlıkla çalmaz (§9B).
SAHIPLENME_YASI_SN=60
SUPURUCU_ARALIK_SN=300
BAYAT_PENDING_DK=5
DENEME_SINIRI=3

# ── Ses birleştirme (§7.6 — prototipte ölçülmüş değerler) ────────────────
# Es koymak sesi bozuyor: gerçek konuşmada öbek içi kelimeler arasında
# sessizlik yoktur. 45 ms crossfade, §7.5'teki 50 ms kuyruk payını eritir.
BIRLESTIRME_BOSLUK_MS=0
BIRLESTIRME_CROSSFADE_MS=45
KESME_KUYRUK_MS=50

# ── Diğer ─────────────────────────────────────────────────────────────────
DIL_KODU=tr-TR
LOG_SEVIYESI=info

# ── GELİŞTİRME KOLAYLIĞI ────────────────────────────────────────────────
# true ise giriş ekranı atlanır ve herkes superadmin olur (yalnız geliştirme).
# ORTAM=uretim ile birlikte kullanılamaz — uygulama açılmaz.
GELISTIRME_GIRIS_ATLA=false
