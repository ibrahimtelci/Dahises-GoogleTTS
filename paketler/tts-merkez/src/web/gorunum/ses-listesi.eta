<table>
  <thead><tr><th>Ses</th><th>Tiyer</th><th>Cinsiyet</th><th>Doğal örnekleme</th><th>Kesme yöntemi</th></tr></thead>
  <tbody>
  <% for (const s of it.sesler) { %>
    <tr>
      <td class="mono"><%= s.ad %></td>
      <td><%= s.tiyer %></td>
      <td><%= s.cinsiyet %></td>
      <td><%= s.dogalOrnekHizi %> Hz</td>
      <td>
        <% if (s.kesmeDestegi) { %>
          <span class="rozet ready">destekliyor</span>
        <% } else { %>
          <span class="rozet failed">kesme desteklemiyor — seçilemez</span>
        <% } %>
      </td>
    </tr>
  <% } %>
  </tbody>
</table>
<p class="soluk kucuk"><%= it.sesler.length %> ses listelendi. Kesme desteklemeyen sesler profil olarak eklenemez.</p>
