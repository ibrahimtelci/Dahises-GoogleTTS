<%~ include('./_ust.eta', it) %>

<div class="page-header d-print-none mb-3">
  <div class="row g-2 align-items-center">
    <div class="col">
      <h2 class="page-title">Kota</h2>
      <div class="text-secondary mt-1">
        Her tiyerin kendi aylık ücretsiz kotası var ve birbirinden bağımsızdır.
        Sert limit kotanın <strong>%90</strong>'ı — Google boşlukları, noktalamayı ve SSML
        etiketlerini de sayar, ayrıca ay dönümünde saat farkı olabilir.
      </div>
    </div>
    <div class="col-auto"><span class="badge bg-secondary-lt"><%= it.donemAdi %></span></div>
  </div>
</div>

<!-- ── Tiyerler ── -->
<div class="row row-cards mb-3">
<% for (const k of it.kotalar) { %>
  <div class="col-12 col-lg-6">
    <div class="card h-100 <%= (k.bant === 'dolu' || k.bant === 'kritik') ? 'border-danger' : (k.bant === 'uyari' ? 'border-warning' : '') %>">
      <div class="card-body">
        <div class="d-flex align-items-center mb-2">
          <h3 class="card-title m-0"><%= k.tiyerAdi %></h3>
          <div class="ms-auto">
            <% if (!k.kesmeDestegi) { %>
              <span class="badge bg-secondary-lt">kullanılamaz</span>
            <% } else if (k.bant === 'dolu') { %>
              <span class="badge bg-danger-lt">sert limit doldu</span>
            <% } else if (k.bant === 'kritik') { %>
              <span class="badge bg-danger-lt">kritik</span>
            <% } else if (k.bant === 'uyari') { %>
              <span class="badge bg-warning-lt">uyarı</span>
            <% } else { %>
              <span class="badge bg-success-lt">normal</span>
            <% } %>
          </div>
        </div>

        <div class="d-flex align-items-baseline mb-2">
          <div class="h1 m-0"><%= k.yuzde.toFixed(1) %><span class="h3 text-secondary">%</span></div>
          <div class="ms-auto text-secondary small">
            <%= k.kullanilan.toLocaleString('tr-TR') %> / <%= k.limitSert.toLocaleString('tr-TR') %>
          </div>
        </div>

        <div class="cubuk <%= k.bant %> mb-3">
          <span style="width:<%= Math.min(100, k.yuzde).toFixed(1) %>%"></span>
        </div>

        <div class="datagrid">
          <div class="datagrid-item">
            <div class="datagrid-title">Kalan</div>
            <div class="datagrid-content fw-medium"><%= k.kalan.toLocaleString('tr-TR') %> karakter</div>
          </div>
          <div class="datagrid-item">
            <div class="datagrid-title">Sıfırlanma</div>
            <div class="datagrid-content"><%= k.sifirlanma %></div>
          </div>
          <div class="datagrid-item">
            <div class="datagrid-title">Toplam kota</div>
            <div class="datagrid-content"><%= k.limitToplam.toLocaleString('tr-TR') %></div>
          </div>
          <div class="datagrid-item">
            <div class="datagrid-title">Eşikler</div>
            <div class="datagrid-content text-secondary small">
              %70 <%= k.uyariEsigi.toLocaleString('tr-TR') %> ·
              %85 <%= k.kritikEsik.toLocaleString('tr-TR') %> ·
              %90 <%= k.limitSert.toLocaleString('tr-TR') %>
            </div>
          </div>
        </div>

        <% if (!k.kesmeDestegi) { %>
          <div class="alert alert-secondary mt-3 mb-0">
            Bu tiyer kesme yöntemini desteklemiyor — profil olarak seçilemez, kota da harcanmaz.
          </div>
        <% } else if (k.bant === 'dolu') { %>
          <div class="alert alert-danger mt-3 mb-0">
            <strong>Sert limit doldu.</strong> Bu tiyerde tüm Google çağrıları durdu ve üretim
            butonları kilitli. Kota ayın başında yenilenir; bekleyen klipler
            <span class="mono">kota_bekliyor</span> durumunda korunuyor, kaybolmuyor.
          </div>
        <% } else if (k.bant === 'kritik') { %>
          <div class="alert alert-danger mt-3 mb-0">
            <strong>Kritik eşik (%85) aşıldı.</strong> Yeni <strong>toplu</strong> üretim durdu;
            tekil fallback üretimi %90 sert limitine kadar sürüyor.
          </div>
        <% } else if (k.bant === 'uyari') { %>
          <div class="alert alert-warning mt-3 mb-0">Uyarı eşiği (%70) aşıldı.</div>
        <% } %>
      </div>
    </div>
  </div>
<% } %>
</div>

<div class="row row-cards">
  <!-- ── Geliştirme bütçesi ── -->
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header"><h3 class="card-title">Google geliştirme bütçesi</h3></div>
      <div class="card-body">
        <p class="text-secondary small">
          Aylık kotadan ayrı, bu geliştirme turuna ait sert sınır. Sayaç diske yazılır;
          süreç yeniden başlayınca sıfırlanmaz.
        </p>
        <div class="d-flex align-items-baseline mb-2">
          <div class="h1 m-0"><%= it.butce.klip %></div>
          <div class="text-secondary ms-1">/ <%= it.butce.klipSiniri %> klip</div>
          <div class="ms-auto">
            <% if (it.butce.kalanKlip === 0) { %>
              <span class="badge bg-danger-lt">doldu</span>
            <% } else { %>
              <span class="badge bg-success-lt"><%= it.butce.kalanKlip %> klip kaldı</span>
            <% } %>
          </div>
        </div>
        <div class="cubuk <%= it.butce.kalanKlip === 0 ? 'dolu' : 'uyari' %> mb-3">
          <span style="width:<%= Math.min(100, (it.butce.klip / it.butce.klipSiniri) * 100).toFixed(1) %>%"></span>
        </div>
        <div class="datagrid">
          <div class="datagrid-item">
            <div class="datagrid-title">Çağrı</div>
            <div class="datagrid-content"><%= it.butce.cagri %></div>
          </div>
          <div class="datagrid-item">
            <div class="datagrid-title">Karakter</div>
            <div class="datagrid-content"><%= it.butce.karakter.toLocaleString('tr-TR') %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Üretim kuyruğu ── -->
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header"><h3 class="card-title">Üretim kuyruğu</h3></div>
      <% const kuyrukGirdileri = Object.entries(it.kuyruk); %>
      <% if (kuyrukGirdileri.length === 0) { %>
        <div class="card-body">
          <div class="empty">
            <p class="empty-title">Kuyruk boş</p>
            <p class="empty-subtitle text-secondary">Üretim bekleyen klip yok.</p>
          </div>
        </div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table table-vcenter card-table">
          <thead><tr><th>Durum</th><th class="text-end">Klip</th></tr></thead>
          <tbody>
          <% for (const [durum, adet] of kuyrukGirdileri) { %>
            <tr>
              <td><span class="rozet <%= durum %>"><%= durum %></span></td>
              <td class="text-end fw-medium"><%= Number(adet).toLocaleString('tr-TR') %></td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>
</div>

<%~ include('./_alt.eta', it) %>
