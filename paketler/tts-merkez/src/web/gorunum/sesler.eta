<%~ include('./_ust.eta', it) %>

<div class="page-header d-print-none mb-3">
  <div class="row g-2 align-items-center">
    <div class="col">
      <h2 class="page-title">Sesler ve deneme</h2>
      <div class="text-secondary mt-1">
        Bir sesi seçip test cümlesini iki hâlde dinleyin: Google&rsquo;ın tek seferde söylediği
        <strong>gerçek</strong> cümle ve bankadan <strong>birleştirilmiş</strong> hâli.
      </div>
    </div>
    <div class="col-auto"><a href="/ayarlar" class="btn">Profil ekle</a></div>
  </div>
</div>

<div class="row row-cards">
  <!-- ── Deneme (asıl iş burada, önce gelsin) ── -->
  <div class="col-12 col-xl-7">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Deneme</h3>
        <div class="card-actions"><span class="badge bg-warning-lt">Google&rsquo;a gerçek istek</span></div>
      </div>
      <div class="card-body">
        <div class="alert alert-warning">
          <strong>Maliyet onaydan önce gösterilir</strong> ve kota sayacına işlenir.
          Birleştirilmiş sürüm <strong>çapraz</strong> kurulur: her parça farklı bir taşıyıcı
          cümleden gelir — aynı cümleden kesip aynı cümleyi yeniden kurmak hiçbir şey kanıtlamaz.
        </div>

        <form hx-post="/sesler/deneme/maliyet" hx-target="#deneme" hx-swap="innerHTML">
          <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
              <label class="form-label" for="dprofil">Profil</label>
              <select id="dprofil" name="profil" class="form-select">
                <% for (const p of it.profiller) { %>
                <option value="<%= p.id %>"><%= p.id %> — <%= p.motor_sesi %> (<%= p.tiyer %>)</option>
                <% } %>
              </select>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label" for="sablonId">Kayıtlı şablon</label>
              <select id="sablonId" name="sablonId" class="form-select">
                <option value="">— serbest metin kullan —</option>
                <% for (const s of it.sablonlar) { %>
                <option value="<%= s.id %>"><%= s.ad %></option>
                <% } %>
              </select>
              <small class="form-hint">Şablon yolu üretim kalitesini temsil eder.</small>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" for="metin">Test metni</label>
            <input id="metin" name="metin" class="form-control"
                   value="sayın Mehmet Karabulut lütfen üç nolu bankoya geçiniz" required>
            <small class="form-hint">
              Serbest metin, ya da şablon seçtiyseniz değerler:
              <span class="mono">ad=Mehmet, soyad=Karabulut, banko=3</span>
            </small>
          </div>

          <button type="submit" class="btn btn-primary">
            Maliyeti hesapla
            <span class="spinner-border spinner-border-sm ms-2 htmx-indicator" role="status"></span>
          </button>
        </form>
      </div>
    </div>

    <div id="deneme" class="mt-3"></div>
  </div>

  <!-- ── Profiller ve canlı ses listesi ── -->
  <div class="col-12 col-xl-5">
    <div class="card mb-3">
      <div class="card-header"><h3 class="card-title">Kayıtlı profiller</h3></div>
      <% if (it.profiller.length === 0) { %>
        <div class="card-body">
          <div class="empty">
            <p class="empty-title">Profil yok</p>
            <p class="empty-subtitle text-secondary">Ayarlar ekranından ses profili ekleyin.</p>
            <div class="empty-action"><a href="/ayarlar" class="btn btn-primary">Ayarlara git</a></div>
          </div>
        </div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table table-vcenter card-table">
          <thead><tr><th>Profil</th><th>Ses</th><th>Tiyer</th><th class="text-end">Örnekleme</th></tr></thead>
          <tbody>
          <% for (const p of it.profiller) { %>
            <tr class="<%= p.aktif ? '' : 'opacity-50' %>">
              <td>
                <span class="fw-medium"><%= p.id %></span>
                <% if (p.varsayilan) { %><span class="badge bg-success-lt ms-1">varsayılan</span><% } %>
                <% if (!p.aktif) { %><span class="badge bg-secondary-lt ms-1">pasif</span><% } %>
              </td>
              <td class="mono text-secondary"><%= p.motor_sesi %></td>
              <td class="text-secondary"><%= p.tiyer %></td>
              <td class="text-end text-secondary"><%= p.ornek_hizi %> Hz</td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Google&rsquo;daki sesler</h3>
        <div class="card-actions">
          <button class="btn btn-sm" hx-get="/sesler/liste" hx-target="#ses-listesi" hx-swap="innerHTML">
            Sesleri çek
            <span class="spinner-border spinner-border-sm ms-1 htmx-indicator" role="status"></span>
          </button>
        </div>
      </div>
      <div class="card-body">
        <p class="text-secondary small">
          Liste <span class="mono">listVoices</span> ile canlı çekilir, elle yazılmaz.
          Bu istek ses üretmez, karakter harcamaz.
        </p>
        <div class="alert alert-secondary mb-3">
          <strong>Chirp 3 HD seçilemez.</strong> SSML <span class="mono">&lt;mark&gt;</span>
          etiketlerine sıfır zaman damgası döndürüyor, kesme yöntemi çalışmıyor.
        </div>
        <div id="ses-listesi"></div>
      </div>
    </div>
  </div>
</div>

<%~ include('./_alt.eta', it) %>
