<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= it.baslik %> · tts-merkez</title>

<!-- Tabler 1.4.0 — kendi paketinden sunulur, CDN yok (bkz. ana.ts statik kayit) -->
<link rel="stylesheet" href="/statik/tabler/css/tabler.min.css">
<script src="/statik/htmx.min.js"></script>

<style>
/* ─────────────────────────────────────────────────────────────────────────
   Tabler koprusu.

   Gorunumler kendi semantik sinif adlarini kullaniyor (kart, rozet, uyari,
   cubuk...). Burada bunlar Tabler'in KENDI degiskenlerine baglaniyor —
   Tabler'in CSS'i kopyalanmiyor, yalnizca isimler eslestiriliyor.

   Ayrica ciplak <button>/<input>/<table> ogeleri de Tabler gorunumunu alir;
   Bootstrap tabanli sistemler bunlari sinif olmadan bicimlendirmez.
   ───────────────────────────────────────────────────────────────────── */

/* Ciplak form ogeleri → Tabler gorunumu */
main input:not([type=checkbox]):not([type=radio]):not([type=file]),
main select, main textarea {
  display: block; width: 100%;
  padding: .4375rem .75rem;
  font-size: .875rem; line-height: 1.4285714286;
  color: var(--tblr-body-color);
  background-color: var(--tblr-bg-forms);
  border: 1px solid var(--tblr-border-color);
  border-radius: var(--tblr-border-radius);
  transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out;
}
main input:focus, main select:focus, main textarea:focus {
  outline: 0; border-color: var(--tblr-primary);
  box-shadow: 0 0 0 .25rem rgba(var(--tblr-primary-rgb), .25);
}
main textarea { min-height: 140px; font-family: var(--tblr-font-monospace); font-size: .8125rem; }
main label { display: block; margin-bottom: .25rem; font-size: .875rem; font-weight: 500; }

main button {
  display: inline-block; padding: .4375rem .875rem;
  font-size: .875rem; font-weight: 500; line-height: 1.4285714286;
  color: #fff; background: var(--tblr-primary); border: 1px solid var(--tblr-primary);
  border-radius: var(--tblr-border-radius); cursor: pointer;
  transition: color .15s, background-color .15s, border-color .15s;
}
main button:hover:not(:disabled) { background: var(--tblr-primary-darken); border-color: var(--tblr-primary-darken); }
main button:disabled { opacity: .5; cursor: not-allowed; }
main button.ikincil {
  color: var(--tblr-body-color); background: var(--tblr-bg-surface);
  border-color: var(--tblr-border-color);
}
main button.ikincil:hover:not(:disabled) { background: var(--tblr-bg-surface-secondary); }
main button.tehlike { background: var(--tblr-danger); border-color: var(--tblr-danger); }
main button.kucuk { padding: .25rem .5rem; font-size: .765625rem; }

/* Kart → Tabler card (govde dolgusu dahil) */
.kart {
  background: var(--tblr-bg-surface);
  border: 1px solid var(--tblr-border-color);
  border-radius: var(--tblr-border-radius);
  box-shadow: var(--tblr-shadow-card);
  padding: 1rem; margin-bottom: 1rem;
}
.kart > h2:first-child, .kart > h1:first-child { margin-top: 0; }

/* Tablolar */
main table {
  width: 100%; margin-bottom: 0;
  color: var(--tblr-body-color); vertical-align: top;
  border-collapse: separate; border-spacing: 0;
  background: var(--tblr-bg-surface);
  border: 1px solid var(--tblr-border-color);
  border-radius: var(--tblr-border-radius); overflow: hidden;
  font-size: .875rem;
}
.kart table { border: 0; border-radius: 0; }
main th, main td {
  padding: .5rem .75rem; text-align: left;
  border-bottom: 1px solid var(--tblr-border-color-translucent);
  vertical-align: top;
}
main th {
  font-size: .625rem; font-weight: 600; letter-spacing: .04em;
  text-transform: uppercase; color: var(--tblr-secondary);
  background: var(--tblr-bg-surface-tertiary); white-space: nowrap;
}
main tbody tr:last-child td { border-bottom: 0; }
main tbody tr:hover td { background: var(--tblr-bg-surface-secondary); }

/* Rozet → Tabler badge (soft renkler) */
.rozet {
  display: inline-flex; align-items: center; gap: .25rem;
  padding: .25rem .5rem; font-size: .625rem; font-weight: 600;
  line-height: 1; border-radius: 100px; white-space: nowrap;
  text-transform: uppercase; letter-spacing: .04em;
}
.rozet.ready        { background: var(--tblr-success-lt); color: var(--tblr-success); }
.rozet.pending      { background: var(--tblr-blue-lt);    color: var(--tblr-blue); }
.rozet.uretiliyor   { background: var(--tblr-azure-lt);   color: var(--tblr-azure); }
.rozet.failed       { background: var(--tblr-danger-lt);  color: var(--tblr-danger); }
.rozet.engellendi   { background: var(--tblr-secondary-lt); color: var(--tblr-secondary); }
.rozet.kota_bekliyor{ background: var(--tblr-warning-lt); color: var(--tblr-warning); }
.rozet.gri          { background: var(--tblr-secondary-lt); color: var(--tblr-secondary); }

/* Bildirim → Tabler alert */
.uyari {
  position: relative; padding: .75rem 1rem; margin-bottom: 1rem;
  border: 1px solid transparent; border-radius: var(--tblr-border-radius);
  font-size: .875rem;
}
.uyari.basari { color: var(--tblr-success); background: var(--tblr-success-lt); border-color: var(--tblr-success-lt); }
.uyari.hata   { color: var(--tblr-danger);  background: var(--tblr-danger-lt);  border-color: var(--tblr-danger-lt); }
.uyari.uyari  { color: var(--tblr-warning); background: var(--tblr-warning-lt); border-color: var(--tblr-warning-lt); }

/* Çubuk → Tabler progress */
.cubuk {
  display: flex; height: 1rem; overflow: hidden; font-size: .625rem;
  background: var(--tblr-progress-bg); border-radius: var(--tblr-border-radius);
}
.cubuk > span { display: block; height: 100%; background: var(--tblr-success); transition: width .6s ease; }
.cubuk.uyari > span { background: var(--tblr-warning); }
.cubuk.kritik > span, .cubuk.dolu > span { background: var(--tblr-danger); }

/* Yardimcilar */
.soluk { color: var(--tblr-secondary) !important; }
.kucuk { font-size: .75rem; }
.mono  { font-family: var(--tblr-font-monospace); font-size: .8125rem; }
.izgara { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1rem; }
form.satir { display: flex; gap: .5rem; flex-wrap: wrap; align-items: flex-end; margin-bottom: 1rem; }
form.satir label { margin-bottom: .25rem; }
.sayfalama { display: flex; gap: .5rem; align-items: center; margin-top: 1rem; font-size: .875rem; }
p.aciklama { color: var(--tblr-secondary); margin: 0 0 1.25rem; max-width: 78ch; font-size: .875rem; }
main h1 { font-size: 1.25rem; font-weight: 600; margin: 0 0 .25rem; }
main h2 { font-size: 1rem; font-weight: 600; margin: 1.5rem 0 .5rem; }
audio { width: 100%; margin-top: .5rem; height: 36px; }
.htmx-request { opacity: .55; transition: opacity .1s; }
</style>
</head>
<body>
<div class="page">

  <!-- ── Kenar çubuğu ── -->
  <aside class="navbar navbar-vertical navbar-expand-lg" data-bs-theme="dark">
    <div class="container-fluid">
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#yan-menu" aria-label="Menü">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="navbar-brand navbar-brand-autodark">
        <a href="/kelimeler" class="d-flex align-items-center text-decoration-none">
          <span class="avatar avatar-sm me-2" style="background:linear-gradient(135deg,#2563eb,#7c3aed)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round">
              <path d="M4 10v4M8 6v12M12 3v18M16 7v10M20 10v4"/>
            </svg>
          </span>
          <span class="text-white fw-bold">tts-merkez</span>
        </a>
      </div>

      <div class="collapse navbar-collapse" id="yan-menu">
        <ul class="navbar-nav pt-lg-2">
          <li class="nav-item"><span class="nav-link text-uppercase small fw-bold text-secondary pb-1" style="pointer-events:none">İçerik</span></li>

          <li class="nav-item <%= it.aktif === 'kelimeler' ? 'active' : '' %>">
            <a class="nav-link" href="/kelimeler">
              <span class="nav-link-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></span>
              <span class="nav-link-title">Kelimeler</span>
            </a>
          </li>
          <li class="nav-item <%= it.aktif === 'toplu' ? 'active' : '' %>">
            <a class="nav-link" href="/toplu">
              <span class="nav-link-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>
              <span class="nav-link-title">Toplu ekleme</span>
            </a>
          </li>
          <li class="nav-item <%= it.aktif === 'sablonlar' ? 'active' : '' %>">
            <a class="nav-link" href="/sablonlar">
              <span class="nav-link-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg></span>
              <span class="nav-link-title">Şablonlar</span>
            </a>
          </li>

          <li class="nav-item mt-2"><span class="nav-link text-uppercase small fw-bold text-secondary pb-1" style="pointer-events:none">Üretim</span></li>

          <li class="nav-item <%= it.aktif === 'sesler' ? 'active' : '' %>">
            <a class="nav-link" href="/sesler">
              <span class="nav-link-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M19 5a9 9 0 0 1 0 14"/></svg></span>
              <span class="nav-link-title">Sesler ve deneme</span>
            </a>
          </li>
          <li class="nav-item <%= it.aktif === 'kota' ? 'active' : '' %>">
            <a class="nav-link" href="/kota">
              <span class="nav-link-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21.2 15A9 9 0 1 1 9 2.8"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg></span>
              <span class="nav-link-title">Kota</span>
            </a>
          </li>
          <li class="nav-item <%= it.aktif === 'gunluk' ? 'active' : '' %>">
            <a class="nav-link" href="/gunluk">
              <span class="nav-link-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg></span>
              <span class="nav-link-title">Günlük</span>
            </a>
          </li>

          <% if (it.kullanici && it.kullanici.rol === 'superadmin') { %>
          <li class="nav-item mt-2"><span class="nav-link text-uppercase small fw-bold text-secondary pb-1" style="pointer-events:none">Yönetim</span></li>

          <li class="nav-item <%= it.aktif === 'kullanicilar' ? 'active' : '' %>">
            <a class="nav-link" href="/kullanicilar">
              <span class="nav-link-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/></svg></span>
              <span class="nav-link-title">Kullanıcılar</span>
            </a>
          </li>
          <li class="nav-item <%= it.aktif === 'ayarlar' ? 'active' : '' %>">
            <a class="nav-link" href="/ayarlar">
              <span class="nav-link-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span>
              <span class="nav-link-title">Ayarlar</span>
            </a>
          </li>
          <% } %>
        </ul>
      </div>
    </div>
  </aside>

  <!-- ── Üst şerit ── -->
  <header class="navbar navbar-expand-md d-print-none sticky-top">
    <div class="container-xl">
      <div class="navbar-nav flex-row order-md-last">
        <% if (it.kullanici) { %>
        <div class="nav-item d-flex align-items-center">
          <span class="avatar avatar-sm me-2 bg-primary-lt"><%= (it.kullanici.ad || '?').slice(0, 2).toLocaleUpperCase('tr-TR') %></span>
          <span class="d-none d-xl-block pe-2">
            <div class="fw-medium lh-1"><%= it.kullanici.ad %></div>
            <div class="mt-1 small text-secondary"><%= it.kullanici.rol %></div>
          </span>
          <a href="/parola" class="nav-link px-2" title="Parola değiştir">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </a>
          <a href="/cikis" class="nav-link px-2" title="Çıkış">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          </a>
        </div>
        <% } %>
      </div>
      <div class="navbar-nav">
        <span class="text-secondary small">tts-merkez <span class="px-1">/</span> <strong class="text-body"><%= it.baslik %></strong></span>
      </div>
    </div>
  </header>

  <!-- ── İçerik ── -->
  <div class="page-wrapper">
    <div class="page-body">
      <div class="container-xl">

<% if (it.girisAtlaniyor) { %>
  <div class="alert alert-danger d-flex align-items-center" role="alert">
    <svg width="20" height="20" class="me-2 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    <div>
      <strong>GİRİŞ ATLANIYOR</strong> — kimlik doğrulaması kapalı, herkes superadmin.
      Yalnız geliştirme içindir. Kapatmak için <span class="mono">.env</span>:
      <span class="mono">GELISTIRME_GIRIS_ATLA=false</span>
    </div>
  </div>
<% } %>

<main>
<% if (it.bildirim) { %>
  <div class="uyari <%= it.bildirim.tur %>"><%= it.bildirim.metin %></div>
<% } %>
