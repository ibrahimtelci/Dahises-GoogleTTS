<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Giriş · tts-merkez</title>
<link rel="stylesheet" href="/statik/tabler/css/tabler.min.css">
<style>
  body {
    background: #16171b;
    background-image:
      radial-gradient(900px 500px at 15% -10%, rgba(37,99,235,.22), transparent 60%),
      radial-gradient(700px 400px at 95% 110%, rgba(124,58,237,.18), transparent 60%);
  }
</style>
</head>
<body class="d-flex flex-column">
<div class="page page-center">
  <div class="container container-tight py-4">

    <div class="text-center mb-4">
      <span class="avatar avatar-md mb-2" style="background:linear-gradient(135deg,#2563eb,#7c3aed)">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round">
          <path d="M4 10v4M8 6v12M12 3v18M16 7v10M20 10v4"/>
        </svg>
      </span>
      <div class="h2 text-white mb-0">tts-merkez</div>
      <div class="text-secondary small">Hastane anons seslendirme sistemi</div>
    </div>

    <form class="card card-md" method="post" action="/giris">
      <div class="card-body">
        <h2 class="h3 text-center mb-1">Yönetim paneli</h2>
        <p class="text-secondary text-center mb-4">Devam etmek için giriş yapın.</p>

        <% if (it.hata) { %>
          <div class="alert alert-danger" role="alert"><%= it.hata %></div>
        <% } %>

        <div class="mb-3">
          <label class="form-label" for="k">Kullanıcı adı</label>
          <input id="k" name="kullaniciAdi" class="form-control" autocomplete="username" autofocus required>
        </div>

        <div class="mb-3">
          <label class="form-label" for="p">Parola</label>
          <input id="p" name="parola" type="password" class="form-control" autocomplete="current-password" required>
        </div>

        <div class="form-footer">
          <button type="submit" class="btn btn-primary w-100">Giriş yap</button>
        </div>
      </div>
    </form>

  </div>
</div>
</body>
</html>
