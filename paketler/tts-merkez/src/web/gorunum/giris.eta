<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<title>Giriş · tts-merkez</title>
<style>
body { font: 15px/1.5 system-ui, sans-serif; background: #f7f7f8; display: grid; place-items: center; min-height: 100vh; margin: 0; }
form { background: #fff; border: 1px solid #d8d8dd; border-radius: 8px; padding: 24px; width: 320px; }
h1 { font-size: 18px; margin: 0 0 16px; }
label { display: block; font-size: 13px; color: #6a6a75; margin: 10px 0 2px; }
input { width: 100%; padding: 8px; border: 1px solid #d8d8dd; border-radius: 6px; font: inherit; }
button { width: 100%; margin-top: 16px; padding: 9px; background: #1f6feb; color: #fff; border: 0; border-radius: 6px; font: inherit; font-weight: 500; cursor: pointer; }
.hata { background: #ffebe9; border: 1px solid #ffcecb; color: #cf222e; padding: 8px 10px; border-radius: 6px; font-size: 14px; margin-bottom: 12px; }
</style>
</head>
<body>
<form method="post" action="/giris">
  <h1>tts-merkez yönetim</h1>
  <% if (it.hata) { %><div class="hata"><%= it.hata %></div><% } %>
  <label for="k">Kullanıcı adı</label>
  <input id="k" name="kullaniciAdi" autocomplete="username" autofocus required>
  <label for="p">Parola</label>
  <input id="p" name="parola" type="password" autocomplete="current-password" required>
  <button type="submit">Giriş</button>
</form>
</body>
</html>
